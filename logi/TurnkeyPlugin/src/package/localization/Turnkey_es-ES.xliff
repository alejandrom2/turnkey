  <file original="$Turnkey___main" source-language="en-US" target-language="es-ES" datatype="plaintext">
    <body>
      <group id="@commands">
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.CommitCommand" translate="yes">
          <source>Commit</source>
          <target>Commit</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.CommitCommand###description" translate="yes">
          <source>Sends a prompt to the thread open in T3 Code.</source>
          <target>Envía un prompt al hilo abierto en T3 Code.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.ContinueCommand" translate="yes">
          <source>Continue</source>
          <target>Continuar</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.ContinueCommand###description" translate="yes">
          <source>Nudges the thread open in T3 Code to continue; opens it when it waits on you.</source>
          <target>Pide al hilo abierto en T3 Code que continúe; lo abre si te está esperando.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.DiagnoseCommand" translate="yes">
          <source>Diagnose</source>
          <target>Diagnosticar</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.ExplainCommand" translate="yes">
          <source>Explain</source>
          <target>Explicar</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.FixTestsCommand" translate="yes">
          <source>Fix tests</source>
          <target>Arreglar tests</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.LimitsCommand" translate="yes">
          <source>Limits</source>
          <target>Límites</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.LimitsCommand###description" translate="yes">
          <source>Shows your tightest T3 Code usage limit.</source>
          <target>Muestra tu límite de uso más ajustado en T3 Code.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MostUrgentCommand" translate="yes">
          <source>Most urgent thread</source>
          <target>Hilo más urgente</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MostUrgentCommand###description" translate="yes">
          <source>Shows what needs you in T3 Code. Choose it to open that thread.</source>
          <target>Muestra lo que te espera en T3 Code. Elígelo para abrir ese hilo.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.SettingsCommand" translate="yes">
          <source>Turnkey Settings</source>
          <target>Ajustes de Turnkey</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.SettingsCommand###description" translate="yes">
          <source>Opens Turnkey Settings: machines, pairing and haptics.</source>
          <target>Abre los ajustes de Turnkey: equipos, vinculación y hápticos.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StatusCommand" translate="yes">
          <source>Thread status</source>
          <target>Estado de hilos</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StatusCommand###description" translate="yes">
          <source>Shows how many T3 Code threads wait on you and how many run. Choose it to open the most urgent.</source>
          <target>Muestra cuántos hilos de T3 Code te esperan y cuántos están en ejecución. Elígelo para abrir el más urgente.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopAllCommand" translate="yes">
          <source>Stop all runs</source>
          <target>Detener todas las ejecuciones</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopAllCommand###description" translate="yes">
          <source>Stops every running T3 Code thread.</source>
          <target>Detiene todos los hilos de T3 Code en ejecución.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopRunCommand" translate="yes">
          <source>Stop run</source>
          <target>Detener ejecución</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopRunCommand###description" translate="yes">
          <source>Stops the T3 Code run that started last.</source>
          <target>Detiene la última ejecución que empezó en T3 Code.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.SendPromptCommand" translate="yes">
          <source>Send prompt</source>
          <target>Enviar prompt</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.SendPromptCommand###description" translate="yes">
          <source>Sends the prompt you write here to the thread open in T3 Code.</source>
          <target>Envía el prompt que escribas aquí al hilo abierto en T3 Code.</target>
        </trans-unit>
      </group>
      <group id="@adjustments">
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.AccessAdjustment" translate="yes">
          <source>Access</source>
          <target>Acceso</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.AccessAdjustment###description" translate="yes">
          <source>Scroll to change the access mode of the thread open in T3 Code; press for the next one.</source>
          <target>Desplaza para cambiar el acceso del hilo abierto en T3 Code; pulsa para el siguiente.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.EffortAdjustment" translate="yes">
          <source>Effort</source>
          <target>Esfuerzo</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.EffortAdjustment###description" translate="yes">
          <source>Scroll to change the effort of the thread open in T3 Code; press for the next level.</source>
          <target>Desplaza para cambiar el esfuerzo del hilo abierto en T3 Code; pulsa para el siguiente nivel.</target>
        </trans-unit>
      </group>
      <group id="@groups">
        <trans-unit id="$Turnkey___GroupName___6A8A9AD90567715A0007" translate="yes">
          <source>Prompts</source>
          <target>Prompts</target>
        </trans-unit>
        <trans-unit id="$Turnkey___GroupName___AED0D0FDAA3E69A00007" translate="yes">
          <source>Threads</source>
          <target>Hilos</target>
        </trans-unit>
        <trans-unit id="$Turnkey___GroupName___33CC4FB3447813B80005" translate="yes">
          <source>Usage</source>
          <target>Uso</target>
        </trans-unit>
        <trans-unit id="$Turnkey___GroupName___44063AC974DF77A40008" translate="yes">
          <source>Settings</source>
          <target>Ajustes</target>
        </trans-unit>
        <trans-unit id="$Turnkey___GroupName___FD04236EB1B372F00005" translate="yes">
          <source>Model</source>
          <target>Modelo</target>
        </trans-unit>
      </group>
    </body>
  </file>
