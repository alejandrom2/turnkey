    <body>
      <group id="@commands">
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.HapticsCommand" translate="yes">
          <source>Haptics on/off</source>
          <target>Hápticos sí/no</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.HapticsCommand###description" translate="yes">
          <source>Turns Turnkey's buzzes on an MX Master 4 on or off.</source>
          <target>Activa o desactiva las vibraciones de Turnkey en un MX Master 4.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MachinesCommand" translate="yes">
          <source>Machines</source>
          <target>Equipos</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MachinesCommand###description" translate="yes">
          <source>Opens Turnkey's machines page, to pair, re-pair or remove T3 Code machines.</source>
          <target>Abre la página de equipos de Turnkey para vincular, volver a vincular o quitar equipos con T3 Code.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MostUrgentCommand" translate="yes">
          <source>Most urgent thread</source>
          <target>Hilo más urgente</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.MostUrgentCommand###description" translate="yes">
          <source>Shows what needs you in T3 Code. Choose it to open that thread.</source>
          <target>Muestra lo que te espera en T3 Code. Elígelo para abrir ese hilo.</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopRunCommand" translate="yes">
          <source>Stop run</source>
          <target>Detener ejecución</target>
        </trans-unit>
        <trans-unit id="$Turnkey___Loupedeck.TurnkeyPlugin.StopRunCommand###description" translate="yes">
          <source>Stops the T3 Code run that started last.</source>
          <target>Detiene la última ejecución que empezó en T3 Code.</target>
        </trans-unit>
      </group>
