{
	"name": "t3-deck",
	"private": true,
	"description": "Stream Deck plugin for T3 Code environments, over T3 Code's client API.",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.alejandrom2.t3deck\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"i18n:check": "vitest run src/core/i18n.test.ts",
		"assets": "node --import ./scripts/resolve-ts.mjs scripts/icons.ts && node scripts/ui.ts && node scripts/profiles.ts"
	},
	"type": "module",
	"devDependencies": {
		"@elgato/cli": "1.10.2",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.0",
		"@rollup/plugin-typescript": "12.3.0",
		"@tsconfig/node20": "20.1.10",
		"@types/node": "24.19.2",
		"rollup": "4.64.5",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.2",
		"@elgato/utils": "0.6.1"
	}
}
