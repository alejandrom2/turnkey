{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "T3 Deck",
	"Version": "0.1.0.0",
	"Author": "alejandrom2",
	"Description": "Watch and steer T3 Code threads from Stream Deck: thread status, stop, prompts, model options and answers, across every provider.",
	"Category": "T3 Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": { "MinimumVersion": "7.1" },
	"OS": [
		{ "Platform": "mac", "MinimumVersion": "12" },
		{ "Platform": "windows", "MinimumVersion": "10" }
	],
	"Nodejs": { "Version": "24" },
	"UUID": "com.alejandrom2.t3deck",
	"Profiles": [{ "Name": "profiles/t3-deck-plus", "DeviceType": 7, "Readonly": false, "DontAutoSwitchWhenInstalled": true }],
	"Actions": [
		{
			"Name": "Activity",
			"UUID": "com.alejandrom2.t3deck.activity",
			"Icon": "imgs/actions/activity/icon",
			"Tooltip": "The most urgent thread matching a filter. Tap opens it in T3 Code.",
			"PropertyInspectorPath": "ui/activity.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/activity/key", "ShowTitle": false }]
		},
		{
			"Name": "New Thread",
			"UUID": "com.alejandrom2.t3deck.new",
			"Icon": "imgs/actions/new/icon",
			"Tooltip": "Starts a new thread in the selected thread's project, no project, or a chosen one; with a saved prompt or empty.",
			"PropertyInspectorPath": "ui/new.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/new/key", "ShowTitle": false }]
		},
		{
			"Name": "Send Prompt",
			"UUID": "com.alejandrom2.t3deck.send",
			"Icon": "imgs/actions/send/icon",
			"Tooltip": "Sends a saved prompt to the selected thread. Hold to interrupt and restart with it.",
			"PropertyInspectorPath": "ui/send.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/send/key", "ShowTitle": false }]
		},
		{
			"Name": "Steer",
			"UUID": "com.alejandrom2.t3deck.steer",
			"Icon": "imgs/actions/steer/icon",
			"Tooltip": "Adds a saved instruction to the selected thread's running turn.",
			"PropertyInspectorPath": "ui/steer.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/steer/key", "ShowTitle": false }]
		},
		{
			"Name": "Quick Prompt",
			"UUID": "com.alejandrom2.t3deck.quick",
			"Icon": "imgs/actions/quick/icon",
			"Tooltip": "Sends an everyday prompt to the selected thread: continue, fix tests, diagnose, explain, commit, or your own.",
			"PropertyInspectorPath": "ui/quick.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/quick/key", "ShowTitle": false }]
		},
		{
			"Name": "Stop",
			"UUID": "com.alejandrom2.t3deck.stop",
			"Icon": "imgs/actions/stop/icon",
			"Tooltip": "Stops the running turn of the thread selected in T3 Code.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/stop/key", "ShowTitle": false }]
		},
		{
			"Name": "Model",
			"UUID": "com.alejandrom2.t3deck.model",
			"Icon": "imgs/actions/model/icon",
			"Tooltip": "Switches the selected thread to a favorite model, or to the next of T3 Code's favorites.",
			"PropertyInspectorPath": "ui/model.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/model/key", "ShowTitle": false }]
		},
		{
			"Name": "Effort",
			"UUID": "com.alejandrom2.t3deck.effort",
			"Icon": "imgs/actions/effort/icon",
			"Tooltip": "Sets the selected thread's reasoning effort, or steps through what its model offers.",
			"PropertyInspectorPath": "ui/effort.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/effort/key", "ShowTitle": false }]
		},
		{
			"Name": "Speed",
			"UUID": "com.alejandrom2.t3deck.speed",
			"Icon": "imgs/actions/speed/icon",
			"Tooltip": "Toggles fast mode on the selected thread where its model offers it.",
			"PropertyInspectorPath": "ui/speed.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/speed/key", "ShowTitle": false }]
		},
		{
			"Name": "Permissions",
			"UUID": "com.alejandrom2.t3deck.permissions",
			"Icon": "imgs/actions/permissions/icon",
			"Tooltip": "Sets the selected thread's access, from Supervised to Full access, or steps through them.",
			"PropertyInspectorPath": "ui/permissions.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/permissions/key", "ShowTitle": false }]
		},
		{
			"Name": "Plan",
			"UUID": "com.alejandrom2.t3deck.plan",
			"Icon": "imgs/actions/plan/icon",
			"Tooltip": "Switches the selected thread between Build and Plan.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/plan/key", "ShowTitle": false }]
		},
		{
			"Name": "Approve",
			"UUID": "com.alejandrom2.t3deck.approve",
			"Icon": "imgs/actions/approve/icon",
			"Tooltip": "Answers the selected thread's approval as far as its settings allow, or opens it in T3 Code.",
			"PropertyInspectorPath": "ui/approve.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/approve/key", "ShowTitle": false }]
		},
		{
			"Name": "Deny",
			"UUID": "com.alejandrom2.t3deck.deny",
			"Icon": "imgs/actions/deny/icon",
			"Tooltip": "Declines the selected thread's approval.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/deny/key", "ShowTitle": false }]
		},
		{
			"Name": "Thread",
			"UUID": "com.alejandrom2.t3deck.slot",
			"Icon": "imgs/actions/slot/icon",
			"Tooltip": "One thread from the board, filled by key position: status, title and timer. Tap opens it in T3 Code; hold selects it.",
			"PropertyInspectorPath": "ui/slot.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/slot/key", "ShowTitle": true, "TitleAlignment": "top" }]
		},
		{
			"Name": "Organize",
			"UUID": "com.alejandrom2.t3deck.organize",
			"Icon": "imgs/actions/organize/icon",
			"Tooltip": "Settles, pins, snoozes, archives or marks the selected thread unread.",
			"PropertyInspectorPath": "ui/organize.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/organize/key", "ShowTitle": false }]
		},
		{
			"Name": "Pull Request",
			"UUID": "com.alejandrom2.t3deck.pr",
			"Icon": "imgs/actions/pr/icon",
			"Tooltip": "The selected thread's pull request and its state. Tap opens it.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/pr/key", "ShowTitle": false }]
		},
		{
			"Name": "Branch",
			"UUID": "com.alejandrom2.t3deck.branch",
			"Icon": "imgs/actions/branch/icon",
			"Tooltip": "The selected thread's branch. Tap opens the thread in T3 Code.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/branch/key", "ShowTitle": false }]
		},
		{
			"Name": "Health",
			"UUID": "com.alejandrom2.t3deck.health",
			"Icon": "imgs/actions/health/icon",
			"Tooltip": "The connection to T3 Code: ready, connecting, needs pairing or failing. Tap reconnects.",
			"PropertyInspectorPath": "ui/environments.html",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/health/key", "ShowTitle": false }]
		},
		{
			"Name": "Threads Dial",
			"UUID": "com.alejandrom2.t3deck.dial.threads",
			"Icon": "imgs/actions/dial-threads/icon",
			"Tooltip": "Rotate through the threads that match its filter, selecting them in T3 Code; press or tap to open one.",
			"PropertyInspectorPath": "ui/threads-dial.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/strip.json",
				"Icon": "imgs/actions/dial-threads/icon",
				"TriggerDescription": { "Rotate": "Select thread", "Push": "Open in T3 Code", "Touch": "Open in T3 Code" }
			},
			"States": [{ "Image": "imgs/actions/dial-threads/key" }]
		},
		{
			"Name": "Power Dial",
			"UUID": "com.alejandrom2.t3deck.dial.model",
			"Icon": "imgs/actions/dial-model/icon",
			"Tooltip": "Changes the selected thread's model, effort or access; press or tap switches Speed where offered.",
			"PropertyInspectorPath": "ui/power.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/strip.json",
				"Icon": "imgs/actions/dial-model/icon",
				"TriggerDescription": { "Rotate": "Preview", "Push": "Apply (or toggle speed)", "Touch": "Toggle speed" }
			},
			"States": [{ "Image": "imgs/actions/dial-model/key" }]
		},
		{
			"Name": "Prompts Dial",
			"UUID": "com.alejandrom2.t3deck.dial.prompts",
			"Icon": "imgs/actions/dial-prompts/icon",
			"Tooltip": "Rotate through your prompts and templates. Press sends to the selected thread; hold starts a new thread.",
			"PropertyInspectorPath": "ui/prompts.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/strip.json",
				"Icon": "imgs/actions/dial-prompts/icon",
				"TriggerDescription": { "Rotate": "Choose prompt", "Push": "Send (hold: new thread)", "Touch": "Send" }
			},
			"States": [{ "Image": "imgs/actions/dial-prompts/key" }]
		},
		{
			"Name": "Answer Dial",
			"UUID": "com.alejandrom2.t3deck.dial.answer",
			"Icon": "imgs/actions/dial-answer/icon",
			"Tooltip": "Answers an agent's question choice by choice, and approvals as far as its settings allow.",
			"PropertyInspectorPath": "ui/answer.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/strip.json",
				"Icon": "imgs/actions/dial-answer/icon",
				"TriggerDescription": { "Rotate": "Choose answer", "Push": "Answer (hold by default)", "Touch": "Open thread" }
			},
			"States": [{ "Image": "imgs/actions/dial-answer/key" }]
		}
	]
}
